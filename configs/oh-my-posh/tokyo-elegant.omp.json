{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#1a1b26",
    "fg": "#c0caf5",
    "fgdim": "#a9b1d6",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "teal": "#73daca",
    "green": "#9ece6a",
    "purple": "#bb9af7",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "orange": "#ff9e64",
    "gray": "#565f89",
    "slate": "#3b4261",
    "slate2": "#414868"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:blue",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:fg",
          "background": "p:slate",
          "template": " {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:fgdim",
          "background": "p:slate2",
          "template": " {{ .Path }} ",
          "options": {
            "style": "folder",
            "folder_icon": "\uf07b",
            "home_icon": "~",
            "folder_separator_icon": "/",
            "max_depth": 4
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:teal",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf00c {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": "\ue0a0 ",
            "branch_identical_icon": "\ue0a0",
            "branch_ahead_icon": "\uf062",
            "branch_behind_icon": "\uf063",
            "branch_gone_icon": "\uf071",
            "commit_icon": "\uf417",
            "tag_icon": "\uf412",
            "rebase_icon": "\ue728",
            "cherry_pick_icon": "\ue29b",
            "revert_icon": "\uf0e2",
            "merge_icon": "\ue727",
            "no_commits_icon": "\uf071"
          }
        },
        {
          "type": "nodejs",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:green",
          "template": " \ue718 {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:yellow",
          "template": " \ue235 {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "golang",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:cyan",
          "template": " \ue627 {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:bg",
          "background": "p:orange",
          "template": " \ue7a8 {{ .Full }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "foreground": "p:fgdim",
          "background": "p:gray",
          "template": " \ufbab {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "battery",
          "style": "plain",
          "foreground": "p:gray",
          "template": "{{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }} ",
          "options": {
            "charging_icon": "\uf0e7",
            "discharging_icon": "\uf0e7",
            "charged_icon": "\uf0e7",
            "full_icon": "\uf240",
            "battery_icon": "\uf241"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:gray",
          "template": "\uf017 {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if gt .Code 0 }}\uf00d {{ .Code }} {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "\ue0b0"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:fgdim",
          "template": " "
        }
      ]
    }
  ]
}