#!/usr/bin/env bash
#
# archkde-restore — my Arch / KDE Plasma setup, in one beautiful command.
#
# Run with NO arguments for the interactive menu. The two commands that
# matter:
#
#   backup  [--label TEXT] [--no-push]   Save the current setup & push it to GitHub
#   restore [--from DIR|latest]          Put everything back on this machine
#
# Advanced (kept for the installer and maintenance, not shown in the menu):
#   install [--global]                   Install this command onto your PATH
#   deps                                 Install every package needed (fresh Arch)
#   update                               Pull the latest version of the installed copy
#   status                               Show OS age, backups, and config status
#   help                                 Show this help
#
# Backups are extensible: drop an executable script into lib/backup/ and it will be
# run automatically every time you call `backup`. Prefix the filename with a number
# to control ordering (e.g. 10-os-age, 20-wallpaper).
#
set -euo pipefail

PROG="archkde-restore"
VERSION="1.1.0"
NAME="ArchKDE-SystemRestore"

# ---------------------------------------------------------------------------
# Resolve the real location of this script (follow symlinks) so the command can
# find the repo it came from even when installed as a symlink in PATH.
# ---------------------------------------------------------------------------
_source="${BASH_SOURCE[0]}"
while [ -h "$_source" ]; do
  _dir="$(cd -P "$(dirname "$_source")" && pwd)"
  _source="$(readlink "$_source")"
  [ "${_source#/*}" = "$_source" ] && _source="$_dir/$_source"
done
REPO_DIR="$(cd -P "$(dirname "$_source")" && pwd)"

CONFIG_SRC="$REPO_DIR/configs"
BACKUP_ITEMS_DIR="$REPO_DIR/lib/backup"
DATE_SRC="$REPO_DIR/os-install-date"

# Runtime locations (user state, not the repo)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME"
DATE_STATE="$STATE_DIR/os-install-date"

# Backups live inside the repo so they can be pushed to GitHub.
BACKUP_DIR="$REPO_DIR/backups"

# Everything needed on a fresh Arch install for this project to work.
# (ttf-meslo-nerd provides MesloLGS Nerd Font Mono, used by the Ghostty config.)
PACMAN_PKGS=(fastfetch ghostty fish git curl ttf-meslo-nerd)
OMP_BIN_URL="https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/posh-linux-amd64"
GITHUB_REPO="https://github.com/nizar2004/ArchKDE-SystemRestore.git"

# Target config locations
FASTFETCH_CFG="$HOME/.config/fastfetch/config.jsonc"
GHOSTTY_CFG="$HOME/.config/ghostty/config"
FISH_CFG="$HOME/.config/fish/config.fish"
OMP_DIR="$HOME/.config/oh-my-posh"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✓ \033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !  \033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m ✗ \033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

as_root() {
  if [ "$(id -u)" -eq 0 ]; then "$@"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then sudo "$@"
  elif [ -t 0 ] && command -v sudo >/dev/null 2>&1; then sudo "$@"
  elif command -v pkexec >/dev/null 2>&1; then pkexec "$@"
  elif command -v sudo >/dev/null 2>&1; then sudo "$@"
  else die "Need root access but found no sudo/pkexec."; fi
}

# Compute a human-readable OS age from a unix timestamp.
age_from() {
  local ts="${1:?timestamp required}"
  local now; now="$(date +%s)"
  local days=$(( (now - ts) / 86400 ))
  if [ "$days" -eq 0 ]; then echo "$(( (now - ts) / 3600 )) hours"; else echo "$days days"; fi
}

# Determine the canonical install date (state file -> repo -> root fs birth time).
# Always keeps $DATE_STATE in sync with whatever value is chosen, so callers can
# read it back. Prints the timestamp (empty if the system can't provide one).
resolve_install_date() {
  if [ -s "$DATE_STATE" ]; then
    cat "$DATE_STATE"
  elif [ -s "$DATE_SRC" ]; then
    mkdir -p "$STATE_DIR"
    cp -f "$DATE_SRC" "$DATE_STATE"
    cat "$DATE_STATE"
  else
    mkdir -p "$STATE_DIR"
    local btime
    btime="$(stat -c %W / 2>/dev/null || stat -f %B / 2>/dev/null || echo 0)"
    # A birth time of 0 (common in VMs) is meaningless — refuse it rather than
    # storing a bogus 20,000-day age.
    if [ -n "$btime" ] && [ "$btime" != "0" ]; then
      printf '%s\n' "$btime" > "$DATE_STATE"
      echo "$btime"
    fi
  fi
}

# Make this copy of the repo a real git clone (needed for `backup` pushes and
# `update`). Handled as a no-op when it already is one.
ensure_git_repo() {
  command -v git >/dev/null 2>&1 || return 1
  [ -d "$REPO_DIR" ] || return 1
  [ -d "$REPO_DIR/.git" ] && return 0

  if git -C "$REPO_DIR" init -q -b main \
     && git -C "$REPO_DIR" remote add origin "$GITHUB_REPO" \
     && git -C "$REPO_DIR" fetch -q origin main \
     && git -C "$REPO_DIR" reset -q --hard origin/main \
     && git -C "$REPO_DIR" branch -q --set-upstream-to=origin/main main
  then
    return 0
  fi
  # A half-initialized repo is worse than none: remove it so a later
  # `deps` run can retry the conversion cleanly.
  rm -rf "$REPO_DIR/.git"
  return 1
}

# ---------------------------------------------------------------------------
# deps — install everything needed on a fresh Arch install
# ---------------------------------------------------------------------------
cmd_deps() {
  info "Installing required packages"

  command -v pacman >/dev/null 2>&1 \
    || die "pacman not found — this tool targets Arch Linux / CachyOS."

  # --- evaluate what is missing (needs no root) ---
  local missing=() p need_omp=false need_chsh=false
  for p in "${PACMAN_PKGS[@]}"; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  command -v oh-my-posh >/dev/null 2>&1 || need_omp=true
  local cur_shell
  cur_shell="$(getent passwd "$(id -un)" | cut -d: -f7 || true)"
  [ "$cur_shell" = "/usr/bin/fish" ] || need_chsh=true

  # --- do all privileged work in ONE root step ---
  # (installs packages, oh-my-posh, registers fish in /etc/shells, chsh).
  # One password prompt under pkexec; sudo credentials are already cached
  # by install.sh's upfront prompt.
  if [ ${#missing[@]} -gt 0 ] || $need_omp || $need_chsh; then
    [ ${#missing[@]} -gt 0 ] && info "Installing from pacman: ${missing[*]}"
    $need_omp && info "oh-my-posh will be installed from GitHub releases"
    $need_chsh && info "fish will be set as the login shell"

    local root_script; root_script="$(mktemp)"
    echo 'set -euo pipefail' > "$root_script"
    if [ ${#missing[@]} -gt 0 ]; then
      printf 'pacman -Sy --needed --noconfirm %s\n' "${missing[*]}" >> "$root_script"
    fi
    if $need_omp; then
      {
        echo 'mkdir -p /usr/local/bin'
        printf 'curl -fsSL %q -o /usr/local/bin/oh-my-posh\n' "$OMP_BIN_URL"
        echo 'chmod +x /usr/local/bin/oh-my-posh'
      } >> "$root_script"
    fi
    if $need_chsh; then
      cat >> "$root_script" <<'EOS'
grep -qxF /usr/bin/fish /etc/shells 2>/dev/null || echo /usr/bin/fish >> /etc/shells
[ -x /usr/bin/fish ] && chsh -s /usr/bin/fish "$(id -un)" || true
EOS
    fi
    as_root bash "$root_script"
    rm -f "$root_script"
  fi

  # --- verify what actually happened ---
  local still_missing=()
  for p in "${PACMAN_PKGS[@]}"; do
    pacman -Qq "$p" >/dev/null 2>&1 || still_missing+=("$p")
  done
  if [ ${#still_missing[@]} -gt 0 ]; then
    warn "Not installed: ${still_missing[*]} — check pacman output above"
  else
    ok "All pacman packages present (${PACMAN_PKGS[*]})"
  fi
  if command -v oh-my-posh >/dev/null 2>&1; then
    ok "oh-my-posh ready: $(oh-my-posh --version 2>/dev/null | head -1)"
  else
    warn "oh-my-posh not available on PATH"
  fi
  cur_shell="$(getent passwd "$(id -un)" | cut -d: -f7 || true)"
  if [ "$cur_shell" = "/usr/bin/fish" ]; then
    ok "fish is the login shell (takes effect after log out/in)"
  else
    warn "Login shell is still $cur_shell — log out and back in to switch to fish"
    warn "(Ghostty is configured to start fish directly, so new windows work right away)"
  fi

  # --- turn a tarball install into a real git clone so backup pushes work ---
  if [ ! -d "$REPO_DIR/.git" ]; then
    info "Converting this copy into a git clone ($GITHUB_REPO)"
    if ensure_git_repo; then
      ok "Install upgraded to a git clone — backups can now be pushed"
    else
      warn "Could not convert to a git clone (missing git or offline)"
      warn "Backups will still save locally. Re-run 'archkde-restore deps' once online."
    fi
  fi
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------
cmd_install() {
  local global=false force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --global) global=true ;;
      --force)  force=true ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option: $1 (try --help)" ;;
    esac
    shift
  done

  local bin_dir="$HOME/.local/bin"
  $global && bin_dir="/usr/local/bin"

  if [ "$bin_dir" = "/usr/local/bin" ] && [ ! -w "$bin_dir" ]; then
    info "Installing command globally to $bin_dir"
    as_root mkdir -p "$bin_dir"
    as_root ln -sf "$REPO_DIR/$PROG" "$bin_dir/$PROG"
  else
    info "Installing command to $bin_dir"
    mkdir -p "$bin_dir"
    ln -sf "$REPO_DIR/$PROG" "$bin_dir/$PROG"
  fi
  ok "Command installed: $bin_dir/$PROG"

  if ! printf '%s' ":$PATH:" | grep -q ":$bin_dir:"; then
    warn "$bin_dir is not in your PATH."
    echo "   Add this to your shell config, then reopen the terminal:"
    case "${SHELL##*/}" in
      fish) echo "     fish_add_path $bin_dir" ;;
      zsh)  echo "     export PATH=\"$bin_dir:\$PATH\"" ;;
      *)    echo "     export PATH=\"$bin_dir:\$PATH\"" ;;
    esac
  else
    ok "Already on PATH"
  fi

  echo
  echo "Usage: $PROG {backup|restore|status|help}"
}

# ---------------------------------------------------------------------------
# backup
# ---------------------------------------------------------------------------
cmd_backup() {
  local label="" no_push=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --label|-l) label="${2:-}"; shift ;;
      --no-push)  no_push=true ;;
      -h|--help)  usage; return 0 ;;
      *) die "Unknown option: $1 (try --help)" ;;
    esac
    shift
  done

  local stamp dest
  stamp="$(date +%Y%m%d-%H%M%S)"
  dest="$BACKUP_DIR/$stamp"
  mkdir -p "$dest"

  info "Backing up current state -> $dest"

  local items=0
  if [ -d "$BACKUP_ITEMS_DIR" ]; then
    for item in "$BACKUP_ITEMS_DIR"/*; do
      [ -f "$item" ] || continue
      [ -x "$item" ] || { warn "Not executable, skipping: $(basename "$item")"; continue; }
      local out
      out="$(AKSR_BACKUP_DIR="$dest" AKSR_DATE_STATE="$DATE_STATE" AKSR_REPO_DIR="$REPO_DIR" \
             AKSR_STATE_DIR="$STATE_DIR" bash "$item" "$dest" 2>&1 || true)"
      if [ -n "$out" ]; then
        ok "$(basename "$item"): $out"
        items=$((items+1))
      fi
    done
  fi

  # A backup always records the OS age, even if no items ran.
  if [ ! -s "$dest/os-install-date" ]; then
    local fallback_date
    fallback_date="$(resolve_install_date)"
    if [ -n "$fallback_date" ] && [ "$fallback_date" != "0" ]; then
      printf '%s\n' "$fallback_date" > "$dest/os-install-date"
      ok "os-install-date: recorded"
      items=$((items+1))
    else
      warn "os-install-date: system birth time unknown and no stored date — skipping"
    fi
  fi

  {
    echo "created: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "label: ${label:-}"
    echo "os-age: $(age_from "$(cat "$dest/os-install-date")")"
    echo "items:"
    ls -1 "$dest" | grep -v '^manifest\.txt$' | sed 's/^/  - /'
  } > "$dest/manifest.txt"

  ok "Backup complete ($items item(s)). Saved to $dest"

  if $no_push; then
    warn "Skipping GitHub push (--no-push)"
  else
    backup_push "$label"
  fi
}

# ---------------------------------------------------------------------------
# git helpers (backup push)
# ---------------------------------------------------------------------------
# Make sure the repo has a commit identity, falling back to the GitHub login.
ensure_git_identity() {
  local dir="${1:?repo dir required}"

  if [ -n "$(git -C "$dir" config user.name 2>/dev/null)" ] && \
     [ -n "$(git -C "$dir" config user.email 2>/dev/null)" ]; then
    return 0
  fi

  command -v gh >/dev/null 2>&1 || { warn "No git identity configured"; return 1; }

  local login name email
  login="$(gh api user --jq .login 2>/dev/null || true)"
  [ -n "$login" ] || { warn "Could not read GitHub identity"; return 1; }

  name="$(gh api user --jq .name 2>/dev/null || true)"
  [ -n "$name" ] || name="$login"
  email="$(gh api user --jq .email 2>/dev/null || true)"
  if [ -z "$email" ] || [ "$email" = "null" ]; then
    email="$login@users.noreply.github.com"
  fi

  git -C "$dir" config user.name "$name"
  git -C "$dir" config user.email "$email"
  ok "Git identity set: $name <$email>"
}

# Commit the new backup and push it so it can be restored from GitHub.
backup_push() {
  local label="${1:-}"

  info "Pushing backup to GitHub"
  if ! ensure_git_identity "$REPO_DIR"; then
    warn "Proceeding without a configured git identity — the commit below may fail"
  fi

  if ! git -C "$REPO_DIR" add -A backups os-install-date 2>/dev/null \
     && ! git -C "$REPO_DIR" add -A 2>/dev/null; then
    warn "Could not stage backup files"
    return 1
  fi

  # Nothing new? Quietly skip.
  if git -C "$REPO_DIR" diff --cached --quiet 2>/dev/null; then
    ok "Nothing new to push"
    return 0
  fi

  local msg="backup: $(date +%Y%m%d-%H%M%S)"
  [ -n "$label" ] && msg="$msg ($label)"

  if ! git -C "$REPO_DIR" commit -m "$msg" >/dev/null 2>&1; then
    warn "Commit failed — is the repo in a clean state?"
    return 1
  fi

  # Push. If the remote has commits this copy doesn't have yet (e.g. the
  # installed copy missed a recent update, or a backup was pushed from
  # another copy), rebase our backup commit onto them and try again.
  local attempt err
  for attempt in 1 2; do
    if err="$(git -C "$REPO_DIR" push origin HEAD 2>&1)"; then
      ok "Pushed to GitHub — restorable on any machine"
      return 0
    fi
    if echo "$err" | grep -qiE 'behind|fast-forward|fetch first|non-fast-forward'; then
      info "Remote has newer commits — rebasing our backup commit onto them"
      if git -C "$REPO_DIR" fetch -q origin main \
         && git -C "$REPO_DIR" rebase -q origin/main 2>/dev/null; then
        continue
      fi
      warn "Could not rebase onto origin/main — resolve manually first:"
      echo "        git -C $REPO_DIR pull --rebase"
      break
    fi
    break
  done

  warn "Push failed. Backup is saved locally. Reason:"
  echo "$err" | tail -3 | sed 's/^/        /'
  echo "        Push it later with: git -C $REPO_DIR push"
}

# ---------------------------------------------------------------------------
# restore
# ---------------------------------------------------------------------------
cmd_restore() {
  local from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option: $1 (try --help)" ;;
    esac
    shift
  done

  # --from latest: use the newest backup stored in the repo.
  if [ "$from" = "latest" ]; then
    from="$(ls -1d "$BACKUP_DIR"/* 2>/dev/null | sort | tail -n 1 || true)"
    [ -n "$from" ] || die "No backups found in $BACKUP_DIR"
    info "Using latest backup: $(basename "$from")"
  fi

  info "Restoring $NAME"

  # --- fastfetch ---
  if [ -f "$CONFIG_SRC/fastfetch-config.jsonc" ]; then
    mkdir -p "$(dirname "$FASTFETCH_CFG")"
    [ -f "$FASTFETCH_CFG" ] && cp -f "$FASTFETCH_CFG" "$FASTFETCH_CFG.bak" && ok "Backed up existing fastfetch config"
    cp -f "$CONFIG_SRC/fastfetch-config.jsonc" "$FASTFETCH_CFG"
    ok "fastfetch -> $FASTFETCH_CFG"
  else
    warn "fastfetch config not found in repo"
  fi

  # --- ghostty ---
  if [ -f "$CONFIG_SRC/ghostty-config" ]; then
    mkdir -p "$(dirname "$GHOSTTY_CFG")"
    [ -f "$GHOSTTY_CFG" ] && cp -f "$GHOSTTY_CFG" "$GHOSTTY_CFG.bak" && ok "Backed up existing Ghostty config"
    cp -f "$CONFIG_SRC/ghostty-config" "$GHOSTTY_CFG"
    ok "ghostty -> $GHOSTTY_CFG"
  else
    warn "ghostty config not found in repo"
  fi

  # --- fish ---
  if [ -f "$CONFIG_SRC/fish-config.fish" ]; then
    mkdir -p "$(dirname "$FISH_CFG")"
    [ -f "$FISH_CFG" ] && cp -f "$FISH_CFG" "$FISH_CFG.bak" && ok "Backed up existing fish config"
    cp -f "$CONFIG_SRC/fish-config.fish" "$FISH_CFG"
    ok "fish -> $FISH_CFG"
  else
    warn "fish config not found in repo"
  fi

  # --- oh-my-posh ---
  if [ -d "$CONFIG_SRC/oh-my-posh" ] && ls "$CONFIG_SRC/oh-my-posh"/*.omp.json >/dev/null 2>&1; then
    mkdir -p "$OMP_DIR"
    cp -f "$CONFIG_SRC/oh-my-posh"/*.omp.json "$OMP_DIR/"
    ok "oh-my-posh themes -> $OMP_DIR ($(ls -1 "$CONFIG_SRC/oh-my-posh"/*.omp.json | wc -l) theme(s))"
  else
    warn "oh-my-posh themes not found in repo"
  fi

  # --- OS install date ---
  if [ -n "$from" ]; then
    if [ -s "$from/os-install-date" ]; then
      mkdir -p "$STATE_DIR"; cp -f "$from/os-install-date" "$DATE_STATE"
      ok "OS age restored from backup: $from"
    else
      die "No os-install-date in backup: $from"
    fi
  else
    resolve_install_date
    if [ -s "$DATE_STATE" ]; then
      ok "OS install date persisted"
    else
      warn "OS install date unknown — run 'archkde-restore backup' once on the machine that has it"
    fi
  fi

  echo
  if [ -s "$DATE_STATE" ]; then
    ok "Done! OS Age is now $(age_from "$(cat "$DATE_STATE")"). Run 'fastfetch' to verify."
  else
    ok "Done! Configs restored. (OS Age was unknown — see warning above.)"
  fi
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
cmd_status() {
  echo "$NAME v$VERSION"
  echo
  echo "Repo:        $REPO_DIR"
  echo "State dir:   $STATE_DIR"
  echo

  local date
  date="$(resolve_install_date)"
  if [ -n "$date" ] && [ "$date" != "0" ]; then
    echo "OS Age:      $(age_from "$date")  (installed $(date -d @"$date" '+%Y-%m-%d' 2>/dev/null || date -r "$date" '+%Y-%m-%d'))"
  else
    echo "OS Age:      unknown (no stored install date)"
  fi
  echo

  echo "Configs:"
  [ -f "$FASTFETCH_CFG" ] && echo "  [x] fastfetch"  || echo "  [ ] fastfetch"
  [ -f "$GHOSTTY_CFG" ]  && echo "  [x] ghostty"    || echo "  [ ] ghostty"
  [ -f "$FISH_CFG" ]     && echo "  [x] fish"       || echo "  [ ] fish"
  [ -d "$OMP_DIR" ]      && echo "  [x] oh-my-posh ($(ls -1 "$OMP_DIR"/*.omp.json 2>/dev/null | wc -l) themes)" || echo "  [ ] oh-my-posh"
  echo

  echo "Backups:"
  if [ -d "$BACKUP_DIR" ] && ls -1 "$BACKUP_DIR" >/dev/null 2>&1; then
    for b in "$BACKUP_DIR"/*/; do
      [ -d "$b" ] || continue
      local name age lbl
      name="$(basename "$b")"
      if [ -s "$b/os-install-date" ]; then age="$(age_from "$(cat "$b/os-install-date")")"; else age="?"; fi
      lbl="$(sed -n 's/^label: *//p' "$b/manifest.txt" 2>/dev/null)"
      printf '  - %s  (OS age: %s)%s\n' "$name" "$age" "${lbl:+  — $lbl}"
    done
    echo "  (pushed to GitHub automatically on each backup)"
  else
    echo "  (none)"
  fi
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------
cmd_update() {
  # Follow symlinks to find the real install location.
  local self="$0"
  while [ -h "$self" ]; do
    local d; d="$(cd -P "$(dirname "$self")" && pwd)"
    self="$(readlink "$self")"
    [ "${self#/*}" = "$self" ] && self="$d/$self"
  done
  local root; root="$(cd -P "$(dirname "$self")" && pwd)"

  if ! [ -d "$root/.git" ]; then
    die "No git repo found at $root. Run 'archkde-restore deps' to convert it, or re-run the one-command installer."
  fi

  info "Updating $root"
  git -C "$root" pull --ff-only
  ok "Updated to the latest version"
}

# ---------------------------------------------------------------------------
# menu — what runs when you just type `archkde-restore`
# ---------------------------------------------------------------------------
cmd_menu() {
  local B='\033[1;34m' Y='\033[1;33m' W='\033[1;37m' D='\033[0;90m' R='\033[0m'

  # Menus need an interactive terminal; in scripts/pipes fall back to help.
  if ! [ -t 0 ]; then usage; return 0; fi

  while true; do
    printf '\n'
    printf '   %b╭─────────────────────────────────────────────╮%b\n' "$B" "$R"
    printf '   %b│%b %b⚡ ArchKDE-SystemRestore%b %b%s%b    %b│%b\n' "$B" "$R" "$W" "$R" "$D" "$VERSION" "$R" "$B" "$R"
    printf '   %b╰─────────────────────────────────────────────╯%b\n' "$B" "$R"
    printf '\n'
    printf '   %bWhat do you want to do?%b\n\n' "$W" "$R"
    printf '     %b1%b)  Backup    %bsave the current setup & push it to GitHub%b\n\n' "$Y" "$R" "$D" "$R"
    printf '     %b2%b)  Restore   %bput everything back on this machine%b\n\n' "$Y" "$R" "$D" "$R"
    printf '     %bq%b)  Quit\n\n' "$Y"
    printf '   %b↳ press a key:%b ' "$D" "$R"

    local K K2
    K=""
    read -r -s -n 1 K || { printf '\n'; return 0; }
    printf '%s\n' "$K"

    case "$K" in
      1) cmd_backup ""
         printf '\n   %bPress Enter to return to the menu, q to quit…%b ' "$D" "$R"
         K2=""; read -r -s -n 1 K2 || return 0
         [ "$K2" = "q" ] && return 0
         printf '\n' ;;
      2) cmd_restore ""
         printf '\n   %bPress Enter to return to the menu, q to quit…%b ' "$D" "$R"
         K2=""; read -r -s -n 1 K2 || return 0
         [ "$K2" = "q" ] && return 0
         printf '\n' ;;
      q|Q|"") printf '   %bBye 👋%b\n' "$D" "$R"; return 0 ;;
      *) printf '   %b(that key does nothing — press 1, 2 or q)%b\n\n' "$D" "$R" ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
usage() {
  local B='\033[1;34m' W='\033[1;37m' D='\033[0;90m' R='\033[0m'
  printf '\n'
  printf '  %b%s%b %b%s%b — my Arch/KDE setup, in one beautiful command\n\n' "$W" "$NAME" "$R" "$D" "v$VERSION" "$R"
  printf '  %barchkde-restore%b              %blaunch the interactive menu%b\n' "$W" "$R" "$D" "$R"
  printf '  %barchkde-restore backup%b       %bsave the current setup & push to GitHub%b\n' "$W" "$R" "$D" "$R"
  printf '  %barchkde-restore restore%b      %bput everything back on this machine%b\n' "$W" "$R" "$D" "$R"
  printf '\n'
  printf '  %bbackup %b[--label TEXT] [--no-push]   ·   %brestore %b[--from DIR|latest]\n' "$W" "$D" "$W" "$D"
  printf '\n'
  printf '  %bAdvanced (installer/maintenance): install, deps, update, status, help%b\n\n' "$D" "$R"
}

arg="${1-}"
case "$arg" in
  menu|"") cmd_menu ;;
  install) shift; cmd_install "$@" ;;
  deps)    shift; cmd_deps    "$@" ;;
  backup)  shift; cmd_backup  "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  update)  shift; cmd_update  "$@" ;;
  status)  shift; cmd_status  "$@" ;;
  help|-h|--help) usage ;;
  *) err "Unknown command: $1"; echo; usage; exit 1 ;;
esac
